      "entry": {
        "id": "rapp_crispy",
        "name": "RAPP Crispy",
        "version": "1.2.1",
        "summary": "A local-first meeting stack. Records a meeting, removes background noise with DeepFilterNet3 (or RNNoise), transcribes it on a whisper.cpp server bound to 127.0.0.1, and writes Summary / Decisions / Action items / Open questions through a hook you own. Also puts a denoised virtual microphone in front of your meeting app. Audio, transcripts and notes are plain files under ~/.rappcrispy/meetings and never leave the machine. Denoise quality is measured, not asserted \u2014 action=bench reproduces it, including the case it handles badly.",
        "category": "productivity",
        "tags": [
          "deepfilternet",
          "denoise",
          "has-ui",
          "local-first",
          "meetings",
          "noise-cancellation",
          "privacy",
          "rapplication",
          "transcription",
          "virtual-microphone",
          "whisper"
        ],
        "license": "MIT",
        "publisher": "@kody-w",
        "quality_tier": "community",
        "tagline": "Record, denoise, transcribe and summarise meetings entirely on your own machine.",
        "manifest_name": "@kody-w/rapp-crispy-singleton",
        "produced_by": {
          "method": "single-file-agent + local-first ui",
          "engines": [
            "ffmpeg arnndn (RNNoise)",
            "whisper.cpp server on 127.0.0.1"
          ],
          "source_files_collapsed": 1,

FROM ghcr.io/d4vinci/scrapling@sha256:65fc31598af6cc5053c63b5f5205524a94964d82fd33b24b6c96c7cb0be35ada

LABEL org.opencontainers.image.source="https://github.com/D4Vinci/Scrapling" \
      org.opencontainers.image.revision="333fa22b7a5821194ce66b59b11f4b16a6484f02" \
      io.rapp.dock.role="scrapling-mac-emulated-qualification"

USER 0:0
RUN cp -a /root/.cache/ms-playwright /opt/ms-playwright \
    && chmod -R a+rX /opt/ms-playwright

ENV HOME=/tmp \
    PLAYWRIGHT_BROWSERS_PATH=/opt/ms-playwright \
    PYTHONDONTWRITEBYTECODE=1 \
    UV_OFFLINE=1 \
    UV_NO_SYNC=1 \
    DO_NOT_TRACK=1

USER 10001:10001
ENTRYPOINT ["/app/.venv/bin/scrapling"]
CMD ["--help"]

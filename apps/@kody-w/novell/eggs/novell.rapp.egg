        {
          "id": "compliance",
          "name": "The Auditor",
          "barb": "Where does the data sit, who can read it, and what does the audit log say?",
          "asks": "Residency, DLP, retention, audit trail.",
          "killed_by": "A data-flow description naming every hop — and, more persuasively, naming what is never transmitted at all.",
          "weight": 9,
          "answered": [

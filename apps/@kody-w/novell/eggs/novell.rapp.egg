        {
          "id": "just_a_demo",
          "name": "Demo Gravity",
          "barb": "Great demo. Name one production user.",
          "asks": "Has anyone run this in anger, for longer than a meeting?",
          "killed_by": "One production instance with a duration and a number. Anonymised is fine — 'a national retailer, 11 weeks, 40 seats' beats a logo you can't cite.",
          "weight": 9,
          "answered": [
            "\\bin production\\b",
            "\\bproduction (user|instance|deployment)\\b",

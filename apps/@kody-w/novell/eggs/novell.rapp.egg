        {
          "id": "so_what",
          "name": "The So-What",
          "barb": "Okay. What number moved?",
          "asks": "Which business metric changed, by how much, measured how?",
          "killed_by": "A before/after with a unit and a timeframe. One real number outranks a page of adjectives.",
          "weight": 10,
          "answered": [

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kody-w.github.io/RAPP_Store/schemas/desktop.schema.json",
  "title": "Optional public federated macOS distribution",
  "description": "Shape only. lib_desktop.py also enforces manifest/version/repository bindings, continuity, public release evidence and streamed artifact integrity.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "platform", "minimum_os", "bundle_id", "source", "release_tag", "artifacts", "prerequisites", "privacy", "setup", "agent_integration"],
  "properties": {
    "schema": {"const": "rapp-desktop/1.0"},
    "platform": {"const": "macos"},
    "minimum_os": {"type": "string", "pattern": "^(1[0-9]|[2-9][0-9])\\.(0|[1-9][0-9]*)(\\.(0|[1-9][0-9]*))?$"},
    "bundle_id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9-]*(\\.[A-Za-z][A-Za-z0-9-]*){2,}$"},
    "source": {"$ref": "#/$defs/source"},
    "release_tag": {"type": "string", "pattern": "^v(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
    "artifacts": {
      "type": "array", "minItems": 1, "maxItems": 4,
      "description": "Unique (arch, format) pairs. DMG evidence uses <id>-<version>-<arch>.evidence[.<sha256>].json; ZIP evidence uses <id>-<version>-<arch>.zip.evidence[.<sha256>].json. An optional full hash suffix must equal evidence.sha256.",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["arch", "format", "url", "bytes", "sha256", "evidence"],
        "properties": {
          "arch": {"enum": ["arm64", "x86_64"]},
          "format": {"enum": ["dmg", "zip"]},
          "url": {
            "allOf": [
              {"$ref": "#/$defs/releaseURL"},
              {"pattern": "\\.evidence(\\.[0-9a-f]{64})?\\.json$"}
            ],
            "description": "Use a new content-addressed asset for corrections; the suffix hashes the exact evidence file bytes, not the archive. lib_desktop.py enforces suffix-to-evidence.sha256 equality."
          },
          "bytes": {"type": "integer", "minimum": 1, "maximum": 1073741824},
          "sha256": {"$ref": "#/$defs/sha256"},
          "evidence": {
            "type": "object", "additionalProperties": false,
            "required": ["url", "bytes", "sha256"],
            "properties": {
              "url": {"$ref": "#/$defs/releaseURL"},
              "bytes": {"type": "integer", "minimum": 1, "maximum": 262144},
              "sha256": {"$ref": "#/$defs/sha256"}
            }
          }
        }
      }
    },
    "prerequisites": {"$ref": "#/$defs/steps"},
    "privacy": {"$ref": "#/$defs/text"},
    "setup": {"$ref": "#/$defs/steps"},
    "agent_integration": {"$ref": "#/$defs/text"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["repo", "commit_sha"],
      "properties": {
        "repo": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*/[A-Za-z0-9][A-Za-z0-9_.-]*$"},
        "commit_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
      }
    },
    "releaseURL": {"type": "string", "pattern": "^https://github\\.com/[A-Za-z0-9][A-Za-z0-9_.-]*/[A-Za-z0-9][A-Za-z0-9_.-]*/releases/download/v[0-9]+\\.[0-9]+\\.[0-9]+/[A-Za-z0-9_.-]+$"},
    "text": {"type": "string", "minLength": 1, "maxLength": 4000, "pattern": "\\S"},
    "steps": {
      "type": "array", "minItems": 1, "maxItems": 20,
      "items": {"type": "string", "minLength": 1, "maxLength": 1000, "pattern": "\\S"}
    }
  }
}

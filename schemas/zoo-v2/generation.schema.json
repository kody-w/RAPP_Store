{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kody-w.github.io/RAPP_Store/schemas/zoo-v2/generation.schema.json",
  "title": "RAPP Zoo Store v2 immutable generation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "generation_id",
    "created_at",
    "source_issue",
    "previous_generation_url",
    "prototypes",
    "tombstones"
  ],
  "properties": {
    "schema": {
      "const": "rapp-zoo-store-generation/2.0"
    },
    "generation_id": {
      "type": "string",
      "pattern": "^(?:issue-[1-9][0-9]*-[0-9a-f]{64}|bootstrap-[0-9]{8})$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "source_issue": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "integer",
          "minimum": 1
        }
      ]
    },
    "previous_generation_url": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^https://raw\\.githubusercontent\\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+/[0-9a-f]{40}/api/v2/generations/(?:issue-[1-9][0-9]*-[0-9a-f]{64}|bootstrap-[0-9]{8})\\.json$"
        }
      ]
    },
    "previous_generation_sha256": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/sha256"
        }
      ]
    },
    "prototypes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/prototype"
      }
    },
    "tombstones": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/tombstone"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "previous_generation_url": {
            "type": "string"
          }
        },
        "required": [
          "previous_generation_url"
        ]
      },
      "then": {
        "required": [
          "previous_generation_sha256"
        ],
        "properties": {
          "previous_generation_sha256": {
            "$ref": "#/$defs/sha256"
          }
        }
      }
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "pinnedRawUrl": {
      "type": "string",
      "pattern": "^https://raw\\.githubusercontent\\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+/[0-9a-f]{40}/[^?#]+$"
    },
    "prototype": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "version",
        "summary",
        "status",
        "artifact",
        "license",
        "wire_contract",
        "identity",
        "ecosystem_acceptance",
        "external_blockers"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{2,63}$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "status": {
          "const": "prototype"
        },
        "artifact": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "url",
            "sha256",
            "media_type"
          ],
          "properties": {
            "url": {
              "$ref": "#/$defs/pinnedRawUrl"
            },
            "sha256": {
              "$ref": "#/$defs/sha256"
            },
            "media_type": {
              "enum": [
                "text/x-python",
                "application/json",
                "application/zip",
                "application/octet-stream"
              ]
            }
          }
        },
        "license": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "spdx",
            "evidence_url",
            "evidence_sha256"
          ],
          "properties": {
            "spdx": {
              "type": "string",
              "pattern": "^MIT(?:\\s+(?:OR|AND)\\s+[A-Za-z0-9.+-]+)*$"
            },
            "evidence_url": {
              "$ref": "#/$defs/pinnedRawUrl"
            },
            "evidence_sha256": {
              "$ref": "#/$defs/sha256"
            }
          }
        },
        "wire_contract": {
          "const": "RAPP/1"
        },
        "identity": {
          "type": "string",
          "pattern": "^rappid:@[a-z0-9][a-z0-9-]{0,38}/[a-z][a-z0-9-]{2,63}:[0-9a-f]{64}$"
        },
        "ecosystem_acceptance": {
          "const": "not-asserted"
        },
        "external_blockers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          }
        }
      }
    },
    "tombstone": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "status",
        "reason",
        "deprecated_at",
        "source_issue",
        "last_version",
        "last_artifact_sha256"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{2,63}$"
        },
        "status": {
          "const": "deprecated"
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "deprecated_at": {
          "type": "string",
          "format": "date-time"
        },
        "source_issue": {
          "type": "integer",
          "minimum": 1
        },
        "last_version": {
          "type": "string"
        },
        "last_artifact_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    }
  }
}
